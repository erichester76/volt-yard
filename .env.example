# Current Supabase API keys from project settings > API Keys.
# Use the publishable key (sb_publishable_...) in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# In Supabase Auth > Providers, enable Email with both "Confirm email" and
# "Email/password" enabled. In Auth > URL Configuration, set Site URL to the
# production NEXT_PUBLIC_APP_URL (never localhost in production), then allow
# that origin and http://localhost:3000/** under Redirect URLs.

# Use the secret key (sb_secret_...) for server-only catalog synchronization.
# Never expose this value to the browser.
SUPABASE_SECRET_KEY=

# Used by Vercel Cron or a trusted scheduler to call /api/catalog/sync.
CRON_SECRET=

# Server-only Google Cloud key with Geocoding API and Places API (New) enabled.
GOOGLE_MAPS_API_KEY=

# Server-only Yelp Fusion API key.
YELP_API_KEY=

# Stripe server credentials. Configure the webhook endpoint as
# https://your-domain/api/stripe/webhook and subscribe to checkout.session.completed
# checkout.session.async_payment_succeeded, customer.subscription.created, customer.subscription.updated,
# and customer.subscription.deleted. Stripe retries non-2xx responses; do not
# proxy this endpoint through a body-parsing middleware.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring Stripe Price IDs for the $9/month Member and $19/month Premium tiers.
# Set the optional portal configuration ID to let customers cancel or change plans
# in Stripe Billing Portal; otherwise plan changes use the server-mediated fallback.
STRIPE_MEMBER_PRICE_ID=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=

# Required Vercel production configuration: canonical public application origin
# used for server-side return URLs (no trailing slash). Production must use HTTPS.
NEXT_PUBLIC_APP_URL=http://localhost:3000
